mapscripts Mossvale_PokemonCenter_MapScripts {
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
    MAP_SCRIPT_ON_LOAD {
        sethealingplacePC(MAP_MOSSVALE_POKEMON_CENTER)
        end
    }
}

script Mossvale_PokemonCenter_EventScript_Nurse {
	setvar(VAR_0x800B, LOCALID_MOSSVALE_NURSE)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	waitbuttonpress
	release
	end
}

script Mossvale_PokemonCenter_EventScript_Gentleman {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Em Mossvale, saio de casa com\num guarda-chuva e volto com\lbarro nas botas.\pMas meus POKéMON adoram\npassear depois da chuva!", MSGBOX_NPC)
        case EN: msgbox("In Mossvale, I leave home with\nan umbrella and come back with\lmud on my boots.\pBut my POKéMON love a walk\nafter the rain!", MSGBOX_NPC)
        case ES: msgbox("En Mossvale, salgo de casa con\nun paraguas y vuelvo con\lbarro en las botas.\p¡A mis POKéMON les encanta\npasear después de la lluvia!", MSGBOX_NPC)
    }
    end
}

script Mossvale_PokemonCenter_EventScript_Girl {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Vim observar os POKéMON que\nse escondem entre as folhas.\pFiquei tão quietinha que um\ndeles dormiu ao meu lado!", MSGBOX_NPC)
        case EN: msgbox("I came to watch the POKéMON\nhiding among the leaves.\pI stayed so still that one\nof them fell asleep beside me!", MSGBOX_NPC)
        case ES: msgbox("Vine a observar a los POKéMON\nque se ocultan entre las hojas.\p¡Me quedé tan quieta que uno\nse durmió a mi lado!", MSGBOX_NPC)
    }
    end
}

script Mossvale_PokemonCenter_EventScript_Boy {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Meu POKéMON pula em todas\nas poças pelo caminho.\pEu tento desviar...\nMas ele sempre me molha!", MSGBOX_NPC)
        case EN: msgbox("My POKéMON jumps into every\npuddle along the way.\pI try to dodge the splashes...\nBut it always gets me!", MSGBOX_NPC)
        case ES: msgbox("Mi POKéMON salta en todos\nlos charcos del camino.\pIntento esquivar el agua...\n¡Pero siempre me moja!", MSGBOX_NPC)
    }
    end
}

script Mossvale_PokemonCenter_EventScript_Teala_BlockStairs {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Sinto muito.\pEstamos trabalhando no subsolo\nagora.\pO acesso ao público está proibido.\pPor favor, tente novamente mais\ntarde.", MSGBOX_NPC)
        case EN: msgbox("Sorry.\pWe are working in the basement\nnow.\pPublic access is prohibited.\pPlease try again later.", MSGBOX_NPC)
        case ES: msgbox("Lo siento.\pEstamos trabajando en el sótano\nahora.\pEl acceso al público está\nprohibido.\pPor favor, inténtelo de nuevo más\ntarde.", MSGBOX_NPC)
    }
    end
}

