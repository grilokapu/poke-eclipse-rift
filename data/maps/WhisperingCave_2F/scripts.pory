mapscripts WhisperingCave_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_GIOVANNI_CAVE_SYMBOL)) {
            setobjectxyperm(LOCALID_WHISPERING_HIKER, 14, 9)
            setobjectmovementtype(LOCALID_WHISPERING_HIKER, MOVEMENT_TYPE_FACE_RIGHT)
        }
        end
    }
}

const ID_GIOVANNI = LOCALID_WHISPERING_GIOVANNI

script WhisperingCave_2F_EventScript_Giovanni_LookingToSymbol_Trigger {
    lock
    removeowe
    moveplayer(moves(walk_right, walk_up, face_up))
    pause(30)
    playse(SE_PIN)
    moveplayer(moves(emote_exclamation_mark))
    waitse
    pause(20)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "…\pVocê também veio até aqui.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "…\pYou came here too.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "…\pTú también has venido hasta aquí.", MSGBOX_AUTOCLOSE)
    }
    applymovement(ID_GIOVANNI, moves(walk_right, face_up))
    applymovement(LOCALID_PLAYER, moves(walk_up, face_up))
    waitmovementall
    pause(30)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Olhe para a parede.\pEssa marca…\nVocê já viu algo parecido?", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Look at the wall.\pThat mark…\nHave you ever seen anything like it?", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Mira la pared.\pEsa marca…\n¿Has visto algo parecido?", MSGBOX_AUTOCLOSE)
    }
    pause(50)
    applymovement(ID_GIOVANNI, moves(face_left))
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovementall
    pause(20)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Eu conheço cada curva desta\ncaverna.\pEssa marca não estava aqui antes.\pOu talvez estivesse…\ne não quisesse ser encontrada.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "I know every turn in this cave.\pThat mark wasn't here before.\pOr perhaps it was…\nand didn't want to be found.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Conozco cada rincón de esta cueva.\pEsa marca no estaba aquí antes.\pO quizá sí…\ny no quería ser encontrada.", MSGBOX_AUTOCLOSE)
    }
    pause(30)
    moveplayer(moves(walk_up, face_up))
    movenpc(ID_GIOVANNI, moves(face_up))
    pause(30)
    playse(SE_PIN)
    moveplayer(moves(emote_question_mark))
    waitse
    pause(20)
    playse(SE_M_CONFUSE_RAY)
    pause(24)
    fadescreen(FADE_TO_WHITE)
    playse(SE_SHINY)
    callnative(CreateCaveSymbol)
    pause(8)
    fadescreen(FADE_FROM_WHITE)
    pause(90)
    playse(SE_PIN)
    movenpc(ID_GIOVANNI, moves(emote_exclamation_mark, delay_16, walk_up, face_left))
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Aquilo não foi um reflexo.\pPor um instante…\npareceu que a caverna olhava de\lvolta para nós.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "That wasn't a reflection.\pFor an instant…\nit felt as though the cave was\llooking back at us.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Eso no fue un reflejo.\pPor un instante…\npareció que la cueva nos devolvía\lla mirada.", MSGBOX_AUTOCLOSE)
    }
    pause(30)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Ela não reagiu quando você chegou.\pEsperou até você ficar diante dela.\pComo se tivesse reconhecido você.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "It didn't react when you arrived.\pIt waited until you stood before it.\pAs if it recognized you.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "No reaccionó cuando llegaste.\pEsperó hasta que te pusiste ante ella.\pComo si te hubiera reconocido.", MSGBOX_AUTOCLOSE)
    }
    pause(20)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Não…\p“Interessante” não é suficiente.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "No…\p“Interesting” isn't enough.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "No…\p“Interesante” no es suficiente.", MSGBOX_AUTOCLOSE)
    }
    pause(30)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Há algo ligado a você que nem esta\npedra consegue esconder.\pAinda não sei o que é.\pMas segredos sempre deixam rastros.\pE eu sou muito bom em segui-los.", MSGBOX_AUTOCLOSE)
        case EN: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Something tied to you cannot be\nhidden even by this stone.\pI don't know what it is yet.\pBut secrets always leave traces.\pAnd I'm very good at following them.", MSGBOX_AUTOCLOSE)
        case ES: msgminibox(PSS_ICON_GIOVANNI, "Giovanni", "Hay algo ligado a ti que ni esta\npiedra puede ocultar.\pAún no sé qué es.\pPero los secretos siempre dejan\nrastros.\pY soy muy bueno siguiéndolos.", MSGBOX_AUTOCLOSE)
    }
    pause(20)
    movenpc(ID_GIOVANNI, moves(face_up))
    pause(30)
    movenpc(ID_GIOVANNI, moves(walk_down * 2, walk_left, walk_down, walk_left * 4, walk_down * 2, delay_16))
    setflag(FLAG_GIOVANNI_CAVE_SYMBOL)
    removeobject(ID_GIOVANNI)
    setobjectxyperm(LOCALID_WHISPERING_HIKER, 14, 9)
    turnobject(LOCALID_WHISPERING_HIKER, DIR_EAST)
    setvar(VAR_WHISPERING_CAVE_2F_EVENT, 1)
    updateowe
    release
    end    
}

script WhisperingCave_2F_EventScript_Hiker_Guard_Way_Talk {
    lock
    faceplayer
    if(flag(FLAG_GIOVANNI_CAVE_SYMBOL)) {
        setspeaker("Gerônimo")
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Desculpa por ter te empurrado\ndaquela saliência!\pEu só queria testar se a gravidade\nainda estava funcionando.\pParece que está!")
            case EN: msgbox("Sorry for pushing you off that\nledge!\pI just wanted to make sure gravity\nwas still working.\pLooks like it is!")
            case ES: msgbox("¡Perdón por empujarte desde esa\ncornisa!\pSolo quería comprobar si la\ngravedad seguía funcionando.\p¡Parece que sí!")
        }
        release
        end
    }
    playse(SE_PIN)
    movenpc(LOCALID_WHISPERING_HIKER, moves(emote_exclamation_mark))
    waitse
    pause(20)
    setspeaker("Gerônimo")
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Espere!\pEstá vendo aquela coisa ali em\nbaixo?")
        case EN: msgbox("Wait!\pDo you see that thing down there?")
        case ES: msgbox("¡Espera!\p¿Ves esa cosa ahí abajo?")
    }
    playse(SE_PIN)
    moveplayer(moves(emote_question_mark, face_down))
    waitse
    pause(20)
    setspeaker("Gerônimo")
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Veja mais de perto…")
        case EN: msgbox("Take a closer look…")
        case ES: msgbox("Míralo más de cerca…")
    }
    moveplayer(moves(walk_down, face_down, delay_16))
    movenpc(LOCALID_WHISPERING_HIKER, moves(walk_right, face_down))
    applymovement(LOCALID_WHISPERING_HIKER, moves(walk_fast_down))
    applymovement(LOCALID_PLAYER, moves(jump_2_down))
    waitmovementall
    movenpc(LOCALID_WHISPERING_HIKER, moves(walk_up, walk_left, face_down))
    release
    end
}

script WhisperingCave_2F_EventScript_Hiker_Guard_Way {
    lock
    playse(SE_PIN)
    movenpc(LOCALID_WHISPERING_HIKER, moves(emote_exclamation_mark))
    waitse
    pause(20)
    movenpc(LOCALID_WHISPERING_HIKER, moves(walk_right, face_down))
    moveplayer(moves(face_up))
    setspeaker("Gerônimo")
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Espere!\pEstá vendo aquela coisa ali em\nbaixo?")
        case EN: msgbox("Wait!\pDo you see that thing down there?")
        case ES: msgbox("¡Espera!\p¿Ves esa cosa ahí abajo?")
    }
    playse(SE_PIN)
    moveplayer(moves(emote_question_mark, face_down))
    waitse
    pause(20)
    setspeaker("Gerônimo")
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Veja mais de perto…")
        case EN: msgbox("Take a closer look…")
        case ES: msgbox("Míralo más de cerca…")
    }
    applymovement(LOCALID_WHISPERING_HIKER, moves(walk_fast_down))
    applymovement(LOCALID_PLAYER, moves(jump_2_down))
    waitmovementall
    movenpc(LOCALID_WHISPERING_HIKER, moves(walk_up, walk_left, face_down))
    setvar(VAR_WHISPERING_CAVE_HIKER_EVENT, 1)
    release
    end
}

const SARAH = TRAINER_PICNICKER_SARAH

script WhisperingCave_2F_EventScript_Picnicker_Battle {
    switch(var(VAR_LANGUAGE)) {
        case PT:
            trainerbattle_single(SARAH, "Que bom encontrar você!\nVamos batalhar!", "Essa derrota não foi nada legal…")
            msgbox("Quanto mais você batalha, mais\nvontade dá de continuar\lbatalhando!")
        case EN:
            trainerbattle_single(SARAH, "It's great to see you!\nLet's have a battle!", "That loss wasn't fun at all…")
            msgbox("The more you battle, the more you\nwant to keep battling!")
        case ES:
            trainerbattle_single(SARAH, "¡Qué bueno encontrarte!\n¡Vamos a combatir!", "Esa derrota no fue nada divertida…")
            msgbox("¡Cuanto más combates, más ganas\ntienes de seguir combatiendo!")
    }
    release
    end
}

script WhisperingCave_2F_EventScript_Rare_Bone_Get {
    finditem(ITEM_RARE_BONE)
    end
}

script WhisperingCave_2F_EventScript_Fisherman_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Muita gente acha que a Old Rod só\nserve para pescar Magikarp.\pMas um bom Pescador sempre\nencontra surpresas!", MSGBOX_NPC)
        case EN: msgbox("Lots of people think the Old Rod\nonly catches Magikarp.\pBut a skilled Fisher can always\nreel in a surprise!", MSGBOX_NPC)
        case ES: msgbox("Mucha gente cree que la Old Rod\nsolo sirve para pescar Magikarp.\p¡Pero un buen Pescador siempre\nencuentra alguna sorpresa!", MSGBOX_NPC)
    }
    end
}

script WhisperingCave_2F_EventScript_Cave_Symbol {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Um símbolo misterioso está gravado\nna parede.", MSGBOX_SIGN)
        case EN: msgbox("A mysterious symbol is carved into\nthe wall.", MSGBOX_SIGN)
        case ES: msgbox("Un símbolo misterioso está grabado\nen la pared.", MSGBOX_SIGN)
    }
    end
}
