mapscripts StonereachCity_Building2_1F_MapScripts {}

script StonereachCity_Building2_1F_EventScript_Scientist {
    switch (var(VAR_LANGUAGE)) {
        case PT: msgbox("Estou comparando amostras das pedras\nda cidade com as da WHISPERING\lCAVE.\pA composição é quase idêntica…\nmas as da caverna vibram em uma\lfrequência incomum.\pTalvez seja apenas pressão\nsubterrânea.\pÉ isso que continuo dizendo a mim\nmesmo, pelo menos.", MSGBOX_NPC)
        case EN: msgbox("I'm comparing samples from the city\nwith stones from WHISPERING CAVE.\pTheir composition is nearly\nidentical…\pBut the cave samples vibrate at an\nunusual frequency.\pPerhaps it's only underground\npressure.\pThat's what I keep telling myself,\nat least.", MSGBOX_NPC)
        case ES: msgbox("Comparo muestras de la ciudad con\npiedras de WHISPERING CAVE.\pSu composición es casi idéntica…\pPero las muestras de la cueva vibran\na una frecuencia inusual.\pQuizá solo sea presión subterránea.\pAl menos, eso sigo diciéndome.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Building2_1F_EventScript_Boy {
    switch (var(VAR_LANGUAGE)) {
        case PT: msgbox("O cientista disse para eu não tocar\nnas amostras.\pEntão eu só cheguei bem perto e\nfiquei olhando.\pUma delas rolou sozinha.\pNão fui eu! Acho…", MSGBOX_NPC)
        case EN: msgbox("The scientist told me not to touch\nthe samples.\pSo I only got really close and\nstared at them.\pOne of them rolled on its own.\pIt wasn't me! I think…", MSGBOX_NPC)
        case ES: msgbox("El científico dijo que no tocara\nlas muestras.\pSolo me acerqué mucho y las miré.\pUna rodó por sí sola.\p¡No fui yo! Creo…", MSGBOX_NPC)
    }
    end
}
