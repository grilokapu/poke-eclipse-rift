mapscripts StonereachCity_Building2_2F_MapScripts {}

script StonereachCity_Building2_2F_EventScript_Expert {
    switch (var(VAR_LANGUAGE)) {
        case PT: msgbox("Uma boa treinadora não observa apenas\no adversário.\pEla sente o chão, o vento e até o\nsilêncio antes de dar uma ordem.\pAs batalhas são vencidas um instante\nantes do primeiro movimento.", MSGBOX_NPC)
        case EN: msgbox("A good Trainer doesn't watch only\nthe opponent.\pShe feels the ground, the wind, and\neven the silence before giving an\lorder.\pBattles are won an instant before\nthe first move.", MSGBOX_NPC)
        case ES: msgbox("Una buena Entrenadora no observa\nsolo al rival.\pSiente el suelo, el viento y hasta\nel silencio antes de dar una orden.\pLos combates se ganan un instante\nantes del primer movimiento.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Building2_2F_EventScript_Hiker {
    switch (var(VAR_LANGUAGE)) {
        case PT: msgbox("Subi muitas montanhas, mas as que\ncercam STONEREACH são diferentes.\pQuando o vento atravessa certas\nfendas, parece formar palavras.\pNunca entendo o que dizem.\nTalvez seja melhor assim.", MSGBOX_NPC)
        case EN: msgbox("I've climbed many mountains, but\nthe ones around STONEREACH differ.\pWhen wind crosses certain cracks,\nit almost seems to form words.\pI never understand what they say.\nPerhaps that's for the best.", MSGBOX_NPC)
        case ES: msgbox("Escalé muchas montañas, pero las de\nSTONEREACH son diferentes.\pCuando el viento cruza ciertas\ngrietas, parece formar palabras.\pNunca entiendo lo que dicen.\nQuizá sea mejor así.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Building2_2F_EventScript_Woman {
    switch (var(VAR_LANGUAGE)) {
        case PT: msgbox("Vim visitar o museu, mas disseram\nque a Professora Hikari está\locupada.\pAlgo importante deve ter sido\ndescoberto.\pQuando cientistas ficam em silêncio,\nos boatos começam a falar por eles.", MSGBOX_NPC)
        case EN: msgbox("I came to visit the museum, but\nthey said Professor Hikari is busy.\pSomething important must have been\ndiscovered.\pWhen scientists fall silent, rumors\nbegin speaking for them.", MSGBOX_NPC)
        case ES: msgbox("Vine a visitar el museo, pero dicen\nque la Profesora Hikari está\locupada.\pAlgo importante debe haberse\ndescubierto.\pCuando los científicos callan, los\nrumores hablan por ellos.", MSGBOX_NPC)
    }
    end
}
