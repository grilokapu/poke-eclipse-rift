mapscripts Route4_MapScripts {}

script Route4_EventScript_Sign {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Rota 4\nCidade Stonereach {UP_ARROW_2}\lSantuário Verdante {DOWN_ARROW}", MSGBOX_SIGN)
        case EN: msgbox("Route 4\nStonereach City {UP_ARROW_2}\lVerdant Sanctum {DOWN_ARROW}", MSGBOX_SIGN)
        case ES: msgbox("Ruta 4\nCiudad Stonereach {UP_ARROW_2}\lSantuário Verdante {DOWN_ARROW}", MSGBOX_SIGN)
    }
    end
}

// A quiet first glimpse of the symbol away from ruins or ancient objects.
script Route4_EventScript_AbsolSymbol {
    if (!flag(FLAG_DEFEATED_STONEREACH_GYM)) {
        end
    }
    if (flag(FLAG_ROUTE4_ABSOL_SYMBOL_EVENT_DONE)) {
        end
    }

    lockall
    moveplayer(moves(walk_down * 2, face_down))
    special(SpawnCameraObject)
    movecamera(moves(walk_down))
    movenpc(LOCALID_ROUTE4_EVENT_ABSOL, moves(face_right))
    pause(36)

    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Absol parece estar observando\nalguma coisa...", MSGBOX_DEFAULT)
        case EN: msgbox("Absol seems to be watching\nsomething...", MSGBOX_DEFAULT)
        case ES: msgbox("Absol parece estar observando\nalgo...", MSGBOX_DEFAULT)
    }
    pause(45)

    // Absol grows uneasy without turning away from the empty patch of ground.
    movenpc(LOCALID_ROUTE4_EVENT_ABSOL, moves(face_up, delay_8, face_down, delay_8, face_right))
    playse(SE_M_CONFUSE_RAY)
    setvar(VAR_0x8004, 1)
    setvar(VAR_0x8005, 1)
    setvar(VAR_0x8006, 4)
    setvar(VAR_0x8007, 4)
    special(ShakeCamera)
    setvar(VAR_0x8000, LOCALID_ROUTE4_EVENT_ABSOL)
    callnative(CreateRoute4GroundSymbol)
    waitstate
    pause(8)

    // It reacts while the mark is still glowing, then puts distance between them.
    playse(SE_PIN)
    movenpc(LOCALID_ROUTE4_EVENT_ABSOL, moves(emote_exclamation_mark, walk_fast_left))
    waitse
    pause(28)

    // The mark has vanished. Absol checks whether the player saw it too.
    movenpc(LOCALID_ROUTE4_EVENT_ABSOL, moves(face_up, delay_16))
    pause(18)
    movenpc(LOCALID_ROUTE4_EVENT_ABSOL, moves(walk_fast_left * 8))
    removeobject(LOCALID_ROUTE4_EVENT_ABSOL)
    setflag(FLAG_ROUTE4_ABSOL_SYMBOL_EVENT_DONE)

    pause(30)
    msgbox("...", MSGBOX_DEFAULT)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Não há nada ali.", MSGBOX_DEFAULT)
        case EN: msgbox("There's nothing there.", MSGBOX_DEFAULT)
        case ES: msgbox("No hay nada ahí.", MSGBOX_DEFAULT)
    }

    movecamera(moves(walk_up))
    special(RemoveCameraObject)
    releaseall
    end
}

script Route4_EventScript_ParasolLady_Battle {
    switch(var(VAR_LANGUAGE)) {
        case PT:
            trainerbattle_single(TRAINER_PARASOL_LADY_CARMEM, "Não há uma nuvem no céu…\pMas meu Wingull pode resolver isso!", "A tempestade passou tão rápido…")
            msgbox("Chuva ou sol, meu Wingull sempre\nestará pronto para voar!")
        case EN:
            trainerbattle_single(TRAINER_PARASOL_LADY_CARMEM, "There isn't a cloud in the sky…\pBut my Wingull can fix that!", "That storm passed so quickly…")
            msgbox("Rain or shine, my Wingull will\nalways be ready to fly!")
        case ES:
            trainerbattle_single(TRAINER_PARASOL_LADY_CARMEM, "No hay ni una nube en el cielo…\p¡Pero mi Wingull puede arreglarlo!", "La tormenta pasó muy rápido…")
            msgbox("¡Llueva o haga sol, mi Wingull\nsiempre estará listo para volar!")
    }
    release
    end
}

