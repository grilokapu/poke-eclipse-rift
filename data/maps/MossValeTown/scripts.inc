MossValeTown_EventScript_FishermanSign_Text_0:
# 41 "data/maps/MossValeTown/scripts.pory"
	.string "Casa do Pescador\pLições de pesca para iniciantes.\nHistórias de pescador para todos.\pO tamanho dos peixes pode variar\na cada relato.$"

MossValeTown_EventScript_FishermanSign_Text_1:
# 42 "data/maps/MossValeTown/scripts.pory"
