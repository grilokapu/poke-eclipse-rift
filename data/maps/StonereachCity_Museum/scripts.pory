mapscripts StonereachCity_Museum_MapScripts {}

const MUSEUM_PLAYER_X = VAR_0x8004

script StonereachCity_Museum_EntranceTrigger {
    if (flag(FLAG_STONEREACH_MUSEUM_ADMISSION_PAID)) {
        end
    }
    lockall
    playse(SE_PIN)
    movenpc(LOCALID_MUSEUM_DOORMAN, moves(emote_exclamation_mark))
    waitse
    getplayerxy(MUSEUM_PLAYER_X, VAR_0x8005)
    switch(var(MUSEUM_PLAYER_X)) {
        case 18: moveplayer(moves(walk_right * 4, face_right))
        case 19: moveplayer(moves(walk_right * 3, face_right))
        case 20: moveplayer(moves(walk_right * 2, face_right))
        case 21: moveplayer(moves(walk_right, face_right))
        case 22: moveplayer(moves(face_right))
    }
    call(StonereachCity_Museum_Admission)
    if (!flag(FLAG_STONEREACH_MUSEUM_ADMISSION_PAID)) {
        moveplayer(moves(walk_down, face_up))
    }
    releaseall
    end
}

script StonereachCity_Museum_Doorman_Talk {
    lock
    faceplayer
    call(StonereachCity_Museum_Admission)
    release
    end
}

script StonereachCity_Museum_Admission {
    if (flag(FLAG_STONEREACH_MUSEUM_ADMISSION_PAID)) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Seu ingresso já está liberado.\pAproveite a visita ao museu!", MSGBOX_DEFAULT)
            case EN: msgbox("Your admission is already cleared.\pEnjoy your visit to the museum!", MSGBOX_DEFAULT)
            case ES: msgbox("Tu entrada ya está autorizada.\p¡Disfruta de tu visita al museo!", MSGBOX_DEFAULT)
        }
        return
    }
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Bem-vindo ao Museu de Stonereach!\pA taxa de visitação é de ¥2.000.\nDeseja pagar para entrar?", MSGBOX_YESNO)
        case EN: msgbox("Welcome to the Stonereach Museum!\pAdmission costs ¥2,000.\nWould you like to pay and enter?", MSGBOX_YESNO)
        case ES: msgbox("¡Bienvenido al Museo de Stonereach!\pLa entrada cuesta ¥2.000.\n¿Quieres pagar para entrar?", MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Sem o ingresso, não posso permitir\nsua entrada.", MSGBOX_DEFAULT)
            case EN: msgbox("Without a ticket, I can't allow\nyou to enter.", MSGBOX_DEFAULT)
            case ES: msgbox("Sin entrada, no puedo permitirte\nel acceso.", MSGBOX_DEFAULT)
        }
        return
    }
    checkmoney(2000)
    if (var(VAR_RESULT) == FALSE) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Você não tem ¥2.000.\pVolte quando tiver o valor da taxa.", MSGBOX_DEFAULT)
            case EN: msgbox("You don't have ¥2,000.\pCome back when you have the fee.", MSGBOX_DEFAULT)
            case ES: msgbox("No tienes ¥2.000.\pVuelve cuando tengas el importe.", MSGBOX_DEFAULT)
        }
        return
    }
    removemoney(2000)
    setflag(FLAG_STONEREACH_MUSEUM_ADMISSION_PAID)
    playse(SE_SHOP)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Pagamento recebido. Obrigado!\pAgora você tem livre acesso ao\nmuseu. Aproveite a visita!", MSGBOX_DEFAULT)
        case EN: msgbox("Payment received. Thank you!\pYou now have free access to the\nmuseum. Enjoy your visit!", MSGBOX_DEFAULT)
        case ES: msgbox("Pago recibido. ¡Gracias!\pYa tienes libre acceso al museo.\n¡Disfruta de la visita!", MSGBOX_DEFAULT)
    }
    return
}

script StonereachCity_Museum_Researcher_Talk {
    lock
    faceplayer
    if (flag(FLAG_STONEREACH_MUSEUM_TRADE_DONE)) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Esse Osso Raro será muito\nimportante para minha pesquisa.\pEspero que cuide bem do seu\lFóssil de Drake!", MSGBOX_DEFAULT)
            case EN: msgbox("That Rare Bone will be very\nimportant to my research.\pI hope you take good care of your\lFossilized Drake!", MSGBOX_DEFAULT)
            case ES: msgbox("Ese Hueso Raro será muy importante\npara mi investigación.\p¡Espero que cuides bien de tu\lDrake Fosilizado!", MSGBOX_DEFAULT)
        }
        release
        end
    }
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Estou procurando um Osso Raro\npara minha pesquisa.\pPosso oferecer um Fóssil de Drake\nem troca. Você aceita?", MSGBOX_YESNO)
        case EN: msgbox("I'm looking for a Rare Bone for my\nresearch.\pI can offer a Fossilized Drake in\nexchange. Do you accept?", MSGBOX_YESNO)
        case ES: msgbox("Busco un Hueso Raro para mi\ninvestigación.\pPuedo ofrecer un Drake Fosilizado a\ncambio. ¿Aceptas?", MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO) {
        release
        end
    }
    checkitem(ITEM_RARE_BONE)
    if (var(VAR_RESULT) == FALSE) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Parece que você não tem um\nOsso Raro.", MSGBOX_DEFAULT)
            case EN: msgbox("It looks like you don't have a\nRare Bone.", MSGBOX_DEFAULT)
            case ES: msgbox("Parece que no tienes un\nHueso Raro.", MSGBOX_DEFAULT)
        }
        release
        end
    }
    checkitemspace(ITEM_FOSSILIZED_DRAKE)
    if (var(VAR_RESULT) == FALSE) {
        switch(var(VAR_LANGUAGE)) {
            case PT: msgbox("Sua Bolsa está cheia.\pAbra espaço e fale comigo novamente.", MSGBOX_DEFAULT)
            case EN: msgbox("Your Bag is full.\pMake room and talk to me again.", MSGBOX_DEFAULT)
            case ES: msgbox("Tu Bolsa está llena.\pHaz espacio y vuelve a hablar conmigo.", MSGBOX_DEFAULT)
        }
        release
        end
    }
    removeitem(ITEM_RARE_BONE)
    giveitem(ITEM_FOSSILIZED_DRAKE)
    setflag(FLAG_STONEREACH_MUSEUM_TRADE_DONE)
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Excelente! Aqui está o Fóssil de\nDrake que prometi.\pObrigado pela troca!", MSGBOX_DEFAULT)
        case EN: msgbox("Excellent! Here's the Fossilized\nDrake I promised.\pThank you for the trade!", MSGBOX_DEFAULT)
        case ES: msgbox("¡Excelente! Aquí tienes el Drake\nFosilizado que prometí.\p¡Gracias por el intercambio!", MSGBOX_DEFAULT)
    }
    release
    end
}

script StonereachCity_Museum_Sign_Armaldo {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Fóssil de ARMALDO\pAs placas de sua carapaça e suas\ngrandes garras estão preservadas.", MSGBOX_SIGN)
