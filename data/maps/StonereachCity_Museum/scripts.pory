script StonereachCity_Museum_Visitor_Gentleman_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Esses fósseis são verdadeiras\njanelas para o passado.\pUma coleção assim não tem preço!", MSGBOX_NPC)
        case EN: msgbox("These fossils are true windows\ninto the past.\pA collection like this is priceless!", MSGBOX_NPC)
        case ES: msgbox("Estos fósiles son auténticas\nventanas al pasado.\p¡Una colección así no tiene precio!", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Visitor_Pokefan_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Imaginar esses Pokémon caminhando\npelo mundo é fascinante!\pQueria ter visto um CRADILY vivo.", MSGBOX_NPC)
        case EN: msgbox("Imagining these Pokémon roaming the\nworld is fascinating!\pI wish I could have seen a living\lCRADILY.", MSGBOX_NPC)
        case ES: msgbox("¡Imaginar a estos Pokémon recorriendo\nel mundo es fascinante!\pOjalá hubiera visto un CRADILY vivo.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Visitor_Boy_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Dois CRANIDOS batiam a cabeça um\nno outro por território?\pEu faço quase a mesma coisa quando\lmeu irmão pega meus brinquedos!", MSGBOX_NPC)
        case EN: msgbox("Two CRANIDOS butted heads over\nterritory?\pI do almost the same thing when my\lbrother takes my toys!", MSGBOX_NPC)
        case ES: msgbox("¿Dos CRANIDOS chocaban sus cabezas\npor el territorio?\p¡Yo hago casi lo mismo cuando mi\lhermano toma mis juguetes!", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Visitor_OldMan_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Esses jarros parecem simples, mas\ncarregam histórias de muitas vidas.\pObjetos comuns também merecem ser\llembrados.", MSGBOX_NPC)
        case EN: msgbox("These jars look simple, but they\ncarry the stories of many lives.\pEveryday objects deserve to be\lremembered too.", MSGBOX_NPC)
        case ES: msgbox("Estas jarras parecen sencillas, pero\nguardan historias de muchas vidas.\pLos objetos cotidianos también\lmerecen ser recordados.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Visitor_Girl_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("A ave daquela escritura antiga\nparece estar protegendo o sol.\pSerá que ela representa um Pokémon\lque ainda existe?", MSGBOX_NPC)
        case EN: msgbox("The bird in that ancient inscription\nlooks like it's guarding the sun.\pCould it depict a Pokémon that\lstill exists?", MSGBOX_NPC)
        case ES: msgbox("El ave de esa escritura antigua\nparece proteger el sol.\p¿Representará a un Pokémon que\ltodavía existe?", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Visitor_Hiker_Talk {
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Já encontrei fósseis durante minhas\ntrilhas, mas nenhum tão completo.\pA rocha guarda seus segredos com\lmuito cuidado.", MSGBOX_NPC)
        case EN: msgbox("I've found fossils on my hikes, but\nnever one this complete.\pStone guards its secrets very\lcarefully.", MSGBOX_NPC)
        case ES: msgbox("He encontrado fósiles en mis rutas,\npero ninguno tan completo.\pLa piedra guarda sus secretos con\lmucho cuidado.", MSGBOX_NPC)
    }
    end
}

script StonereachCity_Museum_Sign_HisuiMap {
    lockall
    switch(var(VAR_LANGUAGE)) {
        case PT: msgbox("Mapa da antiga região de HISUI.\pTraçado em uma época em que vastas\nterras selvagens ainda separavam os\lprimeiros assentamentos humanos.\pMuitos dos lugares retratados aqui\nreceberiam novos nomes com o passar\ldos séculos.", MSGBOX_SIGN)
        case EN: msgbox("Map of the ancient HISUI region.\pDrawn in an age when vast wildlands\nstill separated the first human\lsettlements.\pMany places depicted here would be\ngiven new names over the centuries.", MSGBOX_SIGN)
        case ES: msgbox("Mapa de la antigua región de HISUI.\pTrazado cuando vastas tierras\nsalvajes aún separaban los primeros\lasentamientos humanos.\pMuchos lugares aquí representados\nrecibirían nuevos nombres con el\lpaso de los siglos.", MSGBOX_SIGN)
    }
    closemessage
    special(ShowHisuiMap)
    releaseall
    end
}
